{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flux",
  "scopeName": "source.flux",
  "fileTypes": ["flux"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.flux", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.flux",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "name": "constant.character.escape.flux", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.double.flux",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.flux", "match": "\\\\." }]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.duration.flux", "match": "\\b\\d+[nμumshdw](ys?)?\\b" },
        { "name": "constant.numeric.flux", "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b" },
        { "name": "constant.numeric.hex.flux", "match": "\\b0[xX][0-9a-fA-F]+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.flux", "match": "\\b(package|import|option|builtin|return|test|fn)\\b" },
        { "name": "keyword.operator.logical.flux", "match": "\\b(and|or|not|exists|in)\\b" },
        { "name": "keyword.control.conditional.flux", "match": "\\b(if|then|else)\\b" },
        { "name": "keyword.other.type.flux", "match": "\\b(any|bool|bytes|duration|float|int|uint|regexp|string|time|vector)\\b" },
        { "name": "constant.language.flux", "match": "\\b(true|false|null|empty)\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "support.function.flux", "match": "\\b(from|range|filter|map|reduce|aggregateWindow|yield|window|group|sort|limit|keep|drop|rename|duplicate|join|union|pivot|timeShift|fill|cumulativeSum|derivative|difference|increase|histogram|count|mean|sum|max|min|median|mode|stddev|skew|spread|first|last|unique|distinct|keys|columns|contains|tables|tableFind|getColumn|getRecord|findColumn|findRecord|sleep|to|stateCount|stateDuration|elapsed|integral|log|warn|error|fatal|info|debug|println|generate|events|length|hosts|intParts|uintParts|float64Parts|truncateTimeZone|experimental|now|systemTime|chandeMomentumOscillator|exponentialMovingAverage|doubleExponentialMovingAverage|tripleExponentialMovingAverage|relativeStrengthIndex|tripleEMA|holtWinters|holtLinear|pearsonr|cov|covariance|kaufmansAMA|kaufmansER|quote|ascii|strlen|substring|substringOffset|toLower|toUpper|trim|title|split|splitN|joinStr|assertEquals|assertEmpty|die|panic|rangeStop|monitor|stateChanges|stateChangesOnly|toBool|toDuration|toFloat|toInt|toString|toTime|toUInt|bytes|vectorLen|vectorSort|promqlJoin)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.pipe.flux", "match": "\\|>" },
        { "name": "keyword.operator.assignment.flux", "match": "=" },
        { "name": "keyword.operator.comparison.flux", "match": "(==|!=|<=|>=|<|>)" },
        { "name": "keyword.operator.arithmetic.flux", "match": "(\\+|-|(?!>)\\*|/|%|\\^)" },
        { "name": "keyword.operator.arrow.flux", "match": "=>" },
        { "name": "keyword.operator.concat.flux", "match": "\\+\\+" },
        { "name": "keyword.operator.regex.flux", "match": "(=~|!~)" }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.language.special.flux", "match": "\\b(_measurement|_field|_value|_time|_start|_stop|_result)\\b" },
        { "name": "variable.other.flux", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    }
  }
}
